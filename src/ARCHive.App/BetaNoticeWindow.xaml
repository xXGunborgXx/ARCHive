<Window x:Class="ARCHive.App.BetaNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARCHive Beta"
        Icon="Assets/ARCHive-icon.ico"
        Width="500"
        Height="300"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#0B0E13"
        Foreground="#F3F0EA"
        FontFamily="Segoe UI"
        ShowInTaskbar="True">
    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#F3F0EA"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A7ADB7"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#F2A24B"/>
        <LinearGradientBrush x:Key="HeaderBrush"
                             StartPoint="0,0"
                             EndPoint="1,0">
            <GradientStop Color="#1B2028" Offset="0"/>
            <GradientStop Color="#12161D" Offset="0.68"/>
            <GradientStop Color="#21170F" Offset="1"/>
        </LinearGradientBrush>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#1B212B"/>
            <Setter Property="BorderBrush" Value="#F2A24B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#3A2718"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#54351F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#5A3B20"
            BorderThickness="1"
            Background="#0B0E13">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource HeaderBrush}"
                    BorderBrush="#343B47"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="42"/>
                    </Grid.ColumnDefinitions>
                    <Image Width="17"
                           Height="17"
                           Margin="10,0,7,0"
                           Source="Assets/ARCHive-icon.ico"/>
                    <TextBlock Grid.Column="1"
                               Text="ARCHive Beta"
                               VerticalAlignment="Center"
                               FontSize="11.5"
                               FontWeight="SemiBold"/>
                    <Button Grid.Column="2"
                            Content="&#xE8BB;"
                            FontFamily="Segoe MDL2 Assets"
                            FontWeight="Normal"
                            Padding="0"
                            MinHeight="0"
                            BorderBrush="Transparent"
                            Background="Transparent"
                            Click="OnClose"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="22,18,22,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border HorizontalAlignment="Left"
                        Background="#241A12"
                        BorderBrush="#6B4A2A"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,4">
                    <TextBlock Text="BETA • 7 DAYS"
                               Foreground="#E7B77F"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                </Border>
                <TextBlock x:Name="NoticeTitle"
                           Grid.Row="1"
                           Margin="0,12,0,7"
                           FontSize="20"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="NoticeMessage"
                           Grid.Row="2"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           LineHeight="18"/>
                <Button x:Name="ContinueButton"
                        Grid.Row="3"
                        HorizontalAlignment="Right"
                        IsDefault="True"
                        Click="OnContinue"/>
            </Grid>
        </Grid>
    </Border>
</Window>
